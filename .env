# ============================================
# WekaSafe Backend Configuration - PRODUCTION
# Domain: wekasafesolutions.com (DreamHost)
# ============================================

# --------------------------------------------
# Core app / hosting
# --------------------------------------------
ENVIRONMENT=production

# Public URL of the site once DNS + SSL are live. Used in email links.
BASE_URL=https://wekasafesolutions.com

# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=https://wekasafesolutions.com,https://www.wekasafesolutions.com

# Set to true once the site is served over HTTPS (required in production -
# browsers will silently drop the login cookie over plain HTTP if this is
# true too early, so only flip it on after SSL is working).
SECURE_COOKIES=true

# File Upload Directory
UPLOAD_DIR=uploads

# --------------------------------------------
# Security Settings
# Freshly generated - do not reuse these anywhere else, and do not commit
# this file to any public repository.
# --------------------------------------------
JWT_SECRET=0bWV4cZBjAfGh2hy5Hv5yZeAOxRuG-9vaxiaDeFNqhZTZDl-Uls1ZHxOnrgvf7lq
SESSION_SECRET=esqfbzpadWwjOgozK9HIc2vwQL-S_JsBMjTVrOFayW1vJoVXuvz_ujrJazjRS5Yy
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------
# Email Configuration - DreamHost mailbox
# --------------------------------------------
# ACTION REQUIRED: once wekasafesolutions.com is registered and a mailbox is
# created in the DreamHost panel (e.g. info@wekasafesolutions.com), fill
# these in with that mailbox's real SMTP credentials.
#
# DreamHost SMTP is typically:
#   MAIL_HOST=smtp.dreamhost.com  (or the host shown in your DreamHost panel)
#   MAIL_PORT=587
#
# SECURITY NOTE: the previous .env shipped with a Gmail address and a live
# App Password in plain text. That password must be revoked at
# https://myaccount.google.com/apppasswords - it is not reused here.
MAIL_HOST=smtp.dreamhost.com
MAIL_PORT=587
MAIL_USERNAME=info@wekasafesolutions.com
MAIL_PASSWORD=REPLACE_WITH_DREAMHOST_MAILBOX_PASSWORD
MAIL_FROM=WekaSafe Solutions <info@wekasafesolutions.com>
ADMIN_EMAIL=info@wekasafesolutions.com

# --------------------------------------------
# Alternative Email Providers (reference only - leave commented)
# --------------------------------------------
# Gmail (app password required, 2FA must be on):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
#
# SendGrid:
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
#
# Mailgun:
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@your-domain.mailgun.org
# MAIL_PASSWORD=your-mailgun-password
